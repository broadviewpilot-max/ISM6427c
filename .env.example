# Copy to .env for local use only. In production, set these in Netlify:
# Site configuration -> Environment variables. Never commit real values.
APP_PASSWORD=choose-a-long-shared-passphrase
# Generate each with:  openssl rand -base64 32
SESSION_SECRET=
DATA_ENCRYPTION_KEY=
# Optional: days a sign-in lasts (default 7, max 30)
SESSION_DAYS=7
# Optional email sign-in (Supabase Auth). Leave blank to keep it off.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated list; when set, only these emails may sign in
ALLOWED_EMAILS=
# Hours an email sign-in lasts (default 12, max 168)
EMAIL_SESSION_HOURS=12
