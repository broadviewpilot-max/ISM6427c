# Copy to .env for local use only. In production, set these in Netlify:
# Site configuration -> Environment variables. Never commit real values.
APP_PASSWORD=choose-a-long-shared-passphrase
# Generate each with:  openssl rand -base64 32
SESSION_SECRET=
DATA_ENCRYPTION_KEY=
# Optional: days a sign-in lasts (default 7, max 30)
SESSION_DAYS=7
